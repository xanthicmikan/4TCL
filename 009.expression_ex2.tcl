expr {1/2}
#=>0
expr {1/2.0}
#=>0.5
expr {1.0/2}
#=>0.5
expr {-1/2}
#=>-1
#============================
expr {7%2}
#=>1
expr {8%2}
#=>0
expr {7%-2}
#=>-1
expr {7/-2}
